N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-this-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Optional alert destination. Leave empty until a webhook receiver is ready.
ALERT_WEBHOOK_URL=

# Optional for a paid CoinGecko plan. The public endpoint also works without it.
COINGECKO_API_KEY=
